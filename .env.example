# Copy to .env and fill in. Never commit .env.

# From @BotFather
BOT_TOKEN=123456:ABC-your-token

# Your domain (DNS A record must point to this VPS). Used by Caddy for HTTPS.
DOMAIN=game.example.com
WEBAPP_URL=https://game.example.com

# Optional: BotFather -> /newapp -> short name. Gives t.me/YourBot/<short>?startapp=CODE links
# that open the game directly, exactly like LudoKingProbot. Leave empty to use buttons instead.
# auto = detect whether the BotFather app exists, on = trust it, off = never use t.me/bot/app links
APP_LINKS=auto
APP_SHORT_NAME=play

# Your Telegram user id(s), comma separated (get it from @userinfobot). Enables /addcoins and /stats.
ADMIN_IDS=

STARTING_COINS=1000
DAILY_BONUS=200
RAKE_PERCENT=10
TURN_SECONDS=20

# Browser testing without Telegram. Keep 0 in production.
DEV_MODE=0

# --- Owner / branding (shown in the welcome banner, group welcome and /help) ---
OWNER_NAME=AAKASH
OWNER_USERNAME=Advik_prakashh
SISTER_BOT=Groupingabot
# Coins a player earns per friend who joins through their /invite link
REFERRAL_BONUS=300

# --- MongoDB (optional) ---
# Mirrors all data (users, coins, matches, chats) into MongoDB so nothing is lost on hosts with temporary disks.
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=gamely
