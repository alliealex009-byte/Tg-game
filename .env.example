# Copy to .env and fill in. Never commit .env.

# From @BotFather
BOT_TOKEN=123456:ABC-your-token

# Your domain (DNS A record must point to this VPS). Used by Caddy for HTTPS.
DOMAIN=game.example.com
WEBAPP_URL=https://game.example.com

# Optional: BotFather -> /newapp -> short name. Gives t.me/YourBot/<short>?startapp=CODE links
# that open the game directly, exactly like LudoKingProbot. Leave empty to use buttons instead.
APP_SHORT_NAME=

# Your Telegram user id(s), comma separated (get it from @userinfobot). Enables /addcoins and /stats.
ADMIN_IDS=

STARTING_COINS=1000
DAILY_BONUS=200
RAKE_PERCENT=10
TURN_SECONDS=20

# Browser testing without Telegram. Keep 0 in production.
DEV_MODE=0
